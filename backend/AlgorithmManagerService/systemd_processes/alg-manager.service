[Unit]
Description=Сервис запуска алгоритмов обработки данных с web-интерфейсом
After=network.target

[Service]
WorkingDirectory=/var/www/AlgorithmManagerService/AlgorithmManagerProject
ExecStart=bash -c "../venv/bin/daphne -b 0.0.0.0 -p 8005 AlgorithmManagerProject.asgi:application"
Restart=always
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target

